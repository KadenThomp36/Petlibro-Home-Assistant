user nginx;
worker_processes 1;
pid /run/petlibro-management/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

http {
  access_log /dev/stdout;
  server_tokens off;
  client_max_body_size 1m;

  map $$http_upgrade $$petlibro_connection_upgrade {
    default upgrade;
    '' close;
  }
  map $$http_x_forwarded_proto $$petlibro_forwarded_proto {
    default $$scheme;
    http http;
    https https;
  }
  map $$http_x_ingress_path $$petlibro_ingress_base {
    default '';
    ~^/[A-Za-z0-9._~/-]+$$ $$http_x_ingress_path;
  }
  map $$http_x_forwarded_prefix $$petlibro_direct_base {
    default '';
    ~^/[A-Za-z0-9._~/-]+$$ $$http_x_forwarded_prefix;
  }

  upstream petlibro_management {
    server unix:/run/petlibro-management-http/management.sock;
  }

  server {
    listen 0.0.0.0:${INGRESS_PORT};
    allow ${INGRESS_ALLOW};
    deny all;
    set $$petlibro_response_base $$petlibro_ingress_base;
${PROXY_LOCATION}
  }

${DIRECT_SERVER}
}
