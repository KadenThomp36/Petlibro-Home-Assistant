# Copy to addon/tests/live/.env (ignored). Never commit real values.
# All hostnames and addresses are illustrative; do not include URL schemes.
TEST_ADDON_HOST=
TEST_GO2RTC_RTSP_PORT=8554
TEST_GO2RTC_API_PORT=1984
TEST_STREAM_NAME=

# Reuse a compatible go2rtc binary built from this repo for secondary instances.
# Example: /tmp/petlibro-qualification-go2rtc
TEST_GO2RTC_BINARY=
TEST_FFMPEG_BINARY=ffmpeg
TEST_NODE_BINARY=node
TEST_BROWSER_HEADLESS=1
TEST_STARTUP_SECONDS=40

# Set to 1 only if camera_audio is enabled on the deployed addon.
TEST_EXPECT_AUDIO=0
# Set to 1 only while a reliable audible stimulus is playing near the camera.
TEST_AUDIO_STIMULUS_PRESENT=0

# Optional: RTSP path presented by Frigate's restream layer.
# This is NOT a test of Frigate's motion/detection process or GPU pipeline.
TEST_FRIGATE_RESTREAM_URL=

# Optional, for explicitly permitted direct physical-session tests only.
TEST_FEEDER_IP=
TEST_FEEDER_UID=
TEST_NATIVE_HARNESS_DIR=

# Optional provenance: recorded as operator-asserted, NOT verified from the addon.
TEST_ADDON_IMAGE_DIGEST=
